generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int        @id @default(autoincrement())
  name     String     @default("user")
  email    String     @unique
  password String
  role     String     @default("customer") // or "admin"
  orders   Order[]
  CartItem CartItem[]
}

model Restaurant {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  image       String?
  foods       Food[]
}

model Food {
  id           Int         @id @default(autoincrement())
  name         String
  description  String?
  price        Float
  image        String?
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  CartItem     CartItem[]
  OrderItem    OrderItem[]
}

model OrderItem {
  id       Int @id @default(autoincrement())
  orderId  Int
  foodId   Int
  quantity Int

  order Order @relation(fields: [orderId], references: [id])
  food  Food  @relation(fields: [foodId], references: [id])
}

model Order {
  id                Int              @id @default(autoincrement())
  userId            Int
  user              User             @relation(fields: [userId], references: [id])
  totalPrice        Float?
  status            String           @default("pending")
  createdAt         DateTime         @default(now())
  deliveryPartnerId Int?
  DeliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  items             OrderItem[] // ✅ NEW
  Payment           Payment[]
}

model CartItem {
  id       Int  @id @default(autoincrement())
  userId   Int
  foodId   Int
  quantity Int  @default(1)
  user     User @relation(fields: [userId], references: [id])
  food     Food @relation(fields: [foodId], references: [id])
}

model DeliveryPartner {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  phone    String?
  orders   Order[]
}

model Payment {
  id                Int      @id @default(autoincrement())
  razorpayOrderId   String
  razorpayPaymentId String
  signature         String
  amount            Float
  status            String   @default("success")
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id])
  orderId           Int
}
